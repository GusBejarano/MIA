# Copia este archivo a .env.local y llena los valores reales.
# Nunca subas .env ni .env.local a ningun repositorio.

# Key de Claude API del workspace "MIA by Descuentos Inteligentes" en la organizacion BEDI
ANTHROPIC_API_KEY=

# Modelos (coinciden con las decisiones ya cerradas del plan MVP) - opcionales,
# claudeClient.ts ya trae estos mismos valores como default si se dejan vacios.
MIA_MODEL_SONNET=claude-sonnet-5
MIA_MODEL_HAIKU=claude-haiku-4-5-20251001

# Salt compartido a nivel BEDI para hashear el telefono del usuario (users.phone_hash)
BEDI_HASH_SALT=

# Supabase (proyecto "MIA by Descuentos Inteligentes"). Acceso 100% server-side
# con la service_role key - nunca se expone una key de Supabase al navegador,
# por eso no hay variables NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Panel /admin (Fase 3): key publishable de Supabase Auth, usada SOLO desde
# Server Actions/Route Handlers (nunca en un componente de cliente) para
# manejar la sesion de login + 2FA de admin_users via cookies
# (@supabase/ssr). Es una key distinta de SUPABASE_SERVICE_ROLE_KEY - esta
# respeta RLS/Auth de Supabase en vez de saltarselo, que es justamente lo que
# necesita el flujo de login (a diferencia de las consultas de datos del
# resto de la app, que si usan la service_role key a proposito).
SUPABASE_PUBLISHABLE_KEY=

# Instrumentacion temporal de timing (diagnostico v1.5, ver timing.ts) - "true"
# para que cada paso del flujo justo despues del numero de WhatsApp loguee
# cuanto tardo (Netlify captura estos console.log en los logs de la function).
# Vacio/ausente = silencioso, uso normal.
MIA_DEBUG_TIMING=
